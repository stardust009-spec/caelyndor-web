// Esquema del Aura Mágica — cuentas, progreso de lectura, Sendas, logros y HU.
// Fuente de verdad de identidad del usuario: Postgres (nunca Redis — ver docs/aura-magica.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Las diez Sendas elementales. Las seis primeras son primarias/comunes;
/// CONEXION, TRUENO, VACIO y FE son singulares/raras.
enum Senda {
  LLAMA
  AGUA
  HIELO
  AIRE
  TIERRA
  VIDA
  CONEXION
  TRUENO
  VACIO
  FE
}

/// Rango del Aura según relatos distintos completados (0/1/5/25/50/100).
/// "Cronista de Caelyndor" NO es un rango: es un logro dinámico (ver achievements).
enum RangoAura {
  AURA_LATENTE
  NOVATO_DEL_AURA
  PRIMERA_ESPECIALIZACION
  SEGUNDA_ESPECIALIZACION
  MAESTRIA_AVANZADA
  MAESTRO_DEL_AURA
}

enum CategoriaLogro {
  PROGRESION
  UNIVERSO
  CONDUCTA
}

/// Jerarquía canónica del documento "Habilidades Únicas (HU): El Don Innato":
/// 42 Comunes, 20 Poco Comunes, 10 Épicas, 5 Legendarias.
enum RarezaHu {
  COMUN
  POCO_COMUN
  EPICA
  LEGENDARIA
}

/**
 * Tema visual del sitio: Rubí (día), Noct (noche) o seguir al sistema.
 */
enum ThemePreference {
  RUBI
  NOCT
  SISTEMA
}

enum AvatarStyle {
  CHIBI
  RETRATO_CIRCULAR
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  /// Solo se asigna ADMIN por script manual (scripts/assign-admin.ts) o
  /// directamente en la BD; NINGÚN endpoint de la aplicación puede escribirlo.
  role UserRole @default(USER)

  /// Secreto TOTP del 2FA obligatorio para cuentas admin (otplib).
  totpSecret      String?
  totpConfirmedAt DateTime?

  /// Derivado de los relatos completados; se recalcula en cada completado,
  /// nunca se edita a mano ni se acepta desde el cliente.
  currentRank RangoAura @default(AURA_LATENTE)

  /// EXP total: suma cacheada de ExpLedger (Parte 4). El nivel se deriva de
  /// aquí (src/lib/server/niveles.ts); nunca se edita a mano.
  exp         Int         @default(0)
  expEntradas ExpLedger[]

  // Foro (Torre de los Cronistas / Vestíbulo).
  foroHilos          ForoHilo[]    @relation("HilosDe")
  foroMensajes       ForoMensaje[] @relation("MensajesDe")
  foroLikes          ForoLike[]
  foroReportes       ForoReporte[] @relation("ReportesDe")
  foroOcultados      ForoMensaje[] @relation("MensajesOcultadosPor")
  foroHilosOcultados ForoHilo[]    @relation("HilosOcultadosPor")
  foroResueltos      ForoReporte[] @relation("ReportesResueltosPor")

  quizIntentos QuizIntento[]

  sendaPrincipal Senda?
  sendasCercanas Senda[] @default([])

  habilidadUnicaId        String?
  habilidadUnica          HabilidadUnica? @relation(fields: [habilidadUnicaId], references: [id])
  habilidadUnicaElegidaEn DateTime?

  progresos StoryProgress[]
  logros    UserAchievement[]
  sendaTest SendaTestResult?
  ofertaHu  OfertaHu?
  profile   UserProfile?
  sesiones  AppSession[]

  restricciones           UserRestriction[] @relation("RestriccionesDe")
  restriccionesAplicadas  UserRestriction[] @relation("RestriccionesAplicadasPor")
  restriccionesLevantadas UserRestriction[] @relation("RestriccionesLevantadasPor")

  accesosComoAdmin      AdminAccessLog[]     @relation("AccesosDeAdmin")
  accesosComoObjetivo   AdminAccessLog[]     @relation("AccesosSobreUsuario")
  moderacionesComoAdmin AdminModerationLog[] @relation("ModeracionesDeAdmin")
  moderacionesRecibidas AdminModerationLog[] @relation("ModeracionesSobreUsuario")
}

enum AdminAccessAction {
  VIEW_PROFILE
  VIEW_USER_LIST
  UNAUTHORIZED_ATTEMPT
  EXPORT_USERS
}

/// Auditoría de acceso admin (Parte 3, sección 6). Solo escritura desde la
/// aplicación: no existe endpoint para editarlo ni borrarlo.
model AdminAccessLog {
  id           String            @id @default(cuid())
  adminUserId  String?
  adminUser    User?             @relation("AccesosDeAdmin", fields: [adminUserId], references: [id])
  targetUserId String?
  targetUser   User?             @relation("AccesosSobreUsuario", fields: [targetUserId], references: [id])
  action       AdminAccessAction
  timestamp    DateTime          @default(now())
  ipAddress    String

  /// Solo para EXPORT_USERS: cuántos usuarios salieron en ese archivo.
  /// La exportación deja UNA fila con el total, a diferencia de VIEW_PROFILE
  /// que registra una fila por usuario visto (Parte 3, sección 7.4).
  exportedCount Int?

  @@index([timestamp])
}

enum AdminModerationAction {
  APPLY_RESTRICTION
  LIFT_RESTRICTION
}

/// Log de moderación activa (Parte 3, sección 8.3): quién, sobre quién,
/// qué acción, cuándo y motivo. Solo escritura desde la aplicación.
model AdminModerationLog {
  id           String                @id @default(cuid())
  adminUserId  String
  adminUser    User                  @relation("ModeracionesDeAdmin", fields: [adminUserId], references: [id])
  targetUserId String
  targetUser   User                  @relation("ModeracionesSobreUsuario", fields: [targetUserId], references: [id])
  action       AdminModerationAction
  restriction  RestrictionType
  reason       String
  timestamp    DateTime              @default(now())
  ipAddress    String

  @@index([timestamp])
}

enum RestrictionType {
  ACCION_SILENCIADA
  COMENTARIO_SILENCIADO
  BAN_COMPLETO
}

/// Moderación activa (Parte 3, sección 8): tres restricciones independientes,
/// no un único campo de estado. Nunca se borra una fila al levantarla — se
/// marca active=false con liftedBy/liftedAt para conservar el historial.
/// Expiración: se evalúa al momento de cada request (expiresAt > now); una
/// fila vencida se trata como inactiva sin necesidad de cron.
model UserRestriction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("RestriccionesDe", fields: [userId], references: [id], onDelete: Cascade)

  type      RestrictionType
  active    Boolean         @default(true)
  /// Interno del equipo; nunca se muestra al usuario afectado.
  reason    String
  /// null = permanente hasta levantarla a mano.
  expiresAt DateTime?

  appliedById String
  appliedBy   User      @relation("RestriccionesAplicadasPor", fields: [appliedById], references: [id])
  appliedAt   DateTime  @default(now())
  liftedById  String?
  liftedBy    User?     @relation("RestriccionesLevantadasPor", fields: [liftedById], references: [id])
  liftedAt    DateTime?

  @@index([userId, type, active])
}

/// Datos personales del lector. Política de privacidad por diseño (Parte 2,
/// sección 2.1): todo lo opcional es PRIVADO — visible solo para el propio
/// usuario; un eventual perfil público mostraría solo alias/avatar/rango/logros.
model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Alias público, obligatorio, único; pasa SIEMPRE por PlayerNameModerator.
  alias String @unique

  // Opcionales y privados; la edad se deriva de fechaNacimiento, no se guarda.
  nombre          String?
  apellidoPaterno String?
  apellidoMaterno String?
  fechaNacimiento DateTime?
  pais            String?
  ciudad          String?
  comuna          String?

  avatarId String?
  avatar   AvatarOption? @relation(fields: [avatarId], references: [id])

  themePreference ThemePreference @default(SISTEMA)

  /// Marco de avatar equipado (slug de src/data/marcos.ts). El servidor solo
  /// acepta marcos cuyo logro el usuario ya desbloqueó.
  marcoSlug String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Libro mayor de EXP (Parte 4). Cada entrega lleva una clave única por
/// usuario ("lectura:<slug>", "quiz:<slug>", "libro:<edición>"…): reenviar
/// una petición o reintentar un sync nunca duplica EXP.
model ExpLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clave     String
  cantidad  Int
  createdAt DateTime @default(now())

  @@unique([userId, clave])
  @@index([userId])
}

/// Catálogo cerrado de avatares curado por Claudio. Sin subida de imágenes
/// por parte del usuario, bajo ninguna circunstancia en esta fase.
model AvatarOption {
  id            String      @id @default(cuid())
  slug          String      @unique
  characterName String
  style         AvatarStyle
  imageUrl      String
  /// Exactamente uno en true: es el avatar que recibe todo usuario nuevo.
  isDefault     Boolean     @default(false)
  /// false lo retira del selector sin romper a quienes ya lo tienen elegido.
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)

  perfiles UserProfile[]
}

/// Logros "latentes": promesas visuales sin lógica de desbloqueo. Tabla
/// separada de Achievement a propósito — nunca cuentan para la barra de
/// progreso ni requieren condiciones de servidor.
model AchievementPlaceholder {
  id        String  @id @default(cuid())
  sortOrder Int
  hintText  String?
}

/// Registro server-side de sesiones (híbrido con JWT: el token lleva el id
/// de esta fila como `sid`; toda verificación de identidad la valida aquí,
/// por lo que revocar tiene efecto inmediato en servidor).
model AppSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Derivado del user-agent (ej. "Chrome (Windows)").
  deviceLabel   String
  /// Aproximada a nivel ciudad, derivada de IP (headers de Vercel); nunca exacta.
  locationLabel String

  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  /// Último 2FA verificado en ESTA sesión: el acceso admin expira antes que
  /// la sesión general (reautenticación periódica del área /admin).
  adminVerifiedAt DateTime?

  @@index([userId, revokedAt])
}

/// Progreso de lectura por relato. El contenido de los relatos vive en
/// src/data/stories.ts (no hay tabla de relatos en la BD), por lo que la
/// "FK" es el slug, validado en servidor contra el contenido real.
model StoryProgress {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storySlug String

  /// Posición actual (0-100). Puede bajar si el lector retrocede.
  currentProgress Int @default(0)
  /// Máximo histórico (0-100). Nunca baja.
  highestProgress Int @default(0)

  /// Se fija de forma irreversible al cumplir la regla de lectura
  /// (src/lib/server/readingValidation.ts: 96 % + tiempo + tramos).
  completedAt             DateTime?
  /// Garantiza que la recompensa de completado se entrega una sola vez.
  completionRewardClaimed Boolean   @default(false)

  /// Relecturas completadas después de la primera lectura completa.
  rereadCount Int     @default(0)
  /// Máquina de estados de relectura: se arma cuando, ya completado,
  /// el lector vuelve al inicio; se consume al alcanzar 96% otra vez.
  rereadArmed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storySlug])
  @@index([userId, completedAt])
}

/// Catálogo de logros. El contenido (título, condición) se define en código
/// (src/lib/server/achievementCatalog.ts) y se sincroniza aquí vía seed
/// idempotente; la condición de desbloqueo SIEMPRE se evalúa en servidor.
model Achievement {
  id          String         @id
  slug        String         @unique
  title       String
  description String
  category    CategoriaLogro

  usuarios UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

/// Resultado del Ritual de Afinación. Uno por usuario; la única corrección
/// permitida es la elección manual (eligioManual) y después queda fijo.
model SendaTestResult {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Respuestas crudas del ritual (ids de pregunta -> id de opción).
  respuestas Json

  sendaPrincipalResultado Senda
  sendasCercanasResultado Senda[]

  /// true si el usuario sobrescribió el resultado del cristal (una sola vez).
  eligioManual Boolean  @default(false)
  completedAt  DateTime @default(now())
}

/// Catálogo de Habilidades Únicas (77 en total entre 4 rarezas; se siembra
/// un subconjunto inicial y se completa como contenido, no como código).
model HabilidadUnica {
  id           String   @id
  nombre       String
  descripcion  String
  rareza       RarezaHu
  /// Sendas con afinidad natural a esta HU (para calcularHUCompatibles).
  sendasAfines Senda[]

  usuarios User[]
}

/// Las 3 opciones presentadas en la Prueba del Aura Interna. Se persisten
/// para que /api/hu/choose solo acepte una HU realmente ofrecida.
model OfertaHu {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opciones  String[]
  createdAt DateTime @default(now())
}

/// Hilo del foro (docs/aura-parte-4.md § Foro). `espacio` es "vestibulo"
/// por ahora; los pisos de la Torre serán "piso-1"…"piso-5". `categoria` se
/// valida contra src/data/foro.ts (no es enum para poder cambiarla sin migrar).
/// Las fechas las pone el servidor: nunca se aceptan del cliente.
model ForoHilo {
  id        String @id @default(cuid())
  espacio   String
  categoria String
  titulo    String

  autorId String
  autor   User   @relation("HilosDe", fields: [autorId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  /// Se actualiza con cada respuesta: ordena la lista de hilos.
  ultimaActividad DateTime @default(now())

  fijado  Boolean @default(false)
  cerrado Boolean @default(false)

  /// Moderación: ocultar nunca borra (se conserva para auditoría).
  ocultoEn     DateTime?
  ocultoPorId  String?
  ocultoPor    User?     @relation("HilosOcultadosPor", fields: [ocultoPorId], references: [id])
  ocultoMotivo String?

  mensajes ForoMensaje[]

  @@index([espacio, ocultoEn, fijado, ultimaActividad])
}

/// Mensaje de un hilo. El primero del hilo lleva esApertura = true.
/// Solo texto plano (sin enlaces ni imágenes en esta etapa).
model ForoMensaje {
  id     String   @id @default(cuid())
  hiloId String
  hilo   ForoHilo @relation(fields: [hiloId], references: [id], onDelete: Cascade)

  autorId String
  autor   User   @relation("MensajesDe", fields: [autorId], references: [id], onDelete: Cascade)

  cuerpo     String
  esApertura Boolean  @default(false)
  createdAt  DateTime @default(now())

  /// Caché de ForoLike (se ajusta en la misma transacción que el like).
  likesCount Int @default(0)

  ocultoEn     DateTime?
  ocultoPorId  String?
  ocultoPor    User?     @relation("MensajesOcultadosPor", fields: [ocultoPorId], references: [id])
  ocultoMotivo String?

  likes    ForoLike[]
  reportes ForoReporte[]

  @@index([hiloId, createdAt])
}

/// Me gusta (no existe "no me gusta"). Uno por usuario y mensaje.
model ForoLike {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mensajeId String
  mensaje   ForoMensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([userId, mensajeId])
}

/// Reporte de un mensaje. Uno por usuario y mensaje; nunca se borra.
model ForoReporte {
  id        String      @id @default(cuid())
  mensajeId String
  mensaje   ForoMensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User        @relation("ReportesDe", fields: [autorId], references: [id], onDelete: Cascade)
  /// SPOILER · OFENSIVO · SPAM · OTRO (validado en src/data/foro.ts).
  motivo    String
  detalle   String?
  createdAt DateTime    @default(now())

  resueltoEn    DateTime?
  resueltoPorId String?
  resueltoPor   User?     @relation("ReportesResueltosPor", fields: [resueltoPorId], references: [id])
  /// "oculto" (se ocultó el mensaje) o "descartado".
  resolucion    String?

  @@unique([mensajeId, autorId])
  @@index([resueltoEn, createdAt])
}

/// Intento de un cuestionario (fase 2, docs/aura-parte-4.md § Quiz).
/// Las preguntas viven en código (src/lib/server/quiz/banco); aquí solo se
/// guarda qué se le sirvió a quien, en qué orden y qué respondió. El intento
/// abierto (entregadoEn = null) conserva siempre las mismas preguntas: salir
/// y volver no permite sortear otras.
model QuizIntento {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Slug de la obra (relato) del cuestionario.
  obra      String
  /// "principal" (explícitas + implícitas) o "conexiones" (desafío avanzado).
  modalidad String

  /// Ids de las preguntas servidas, en el orden en que se muestran.
  preguntas     String[]
  /// Por pregunta, el orden barajado de sus opciones (índices originales).
  ordenOpciones Json
  /// Respuestas parciales: { [preguntaId]: índice ORIGINAL elegido }.
  respuestas    Json     @default("{}")

  createdAt     DateTime  @default(now())
  entregadoEn   DateTime?
  aciertos      Int?
  aprobado      Boolean?
  /// Personaje que interfirió al reprobar (src/data/eventosQuiz.ts).
  eventoFracaso String?

  @@index([userId, obra, modalidad, createdAt])
  @@index([userId, aprobado])
}
