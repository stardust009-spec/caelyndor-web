// Esquema del Aura Mágica — cuentas, progreso de lectura, Sendas, logros y HU.
// Fuente de verdad de identidad del usuario: Postgres (nunca Redis — ver docs/aura-magica.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Las diez Sendas elementales. Las seis primeras son primarias/comunes;
/// CONEXION, TRUENO, VACIO y FE son singulares/raras.
enum Senda {
  LLAMA
  AGUA
  HIELO
  AIRE
  TIERRA
  VIDA
  CONEXION
  TRUENO
  VACIO
  FE
}

/// Rango del Aura según relatos distintos completados (0/1/5/25/50/100).
/// "Cronista de Caelyndor" NO es un rango: es un logro dinámico (ver achievements).
enum RangoAura {
  AURA_LATENTE
  NOVATO_DEL_AURA
  PRIMERA_ESPECIALIZACION
  SEGUNDA_ESPECIALIZACION
  MAESTRIA_AVANZADA
  MAESTRO_DEL_AURA
}

enum CategoriaLogro {
  PROGRESION
  UNIVERSO
  CONDUCTA
}

/// Jerarquía canónica del documento "Habilidades Únicas (HU): El Don Innato":
/// 42 Comunes, 20 Poco Comunes, 10 Épicas, 5 Legendarias.
enum RarezaHu {
  COMUN
  POCO_COMUN
  EPICA
  LEGENDARIA
}

/** Tema visual del sitio: Rubí (día), Noct (noche) o seguir al sistema. */
enum ThemePreference {
  RUBI
  NOCT
  SISTEMA
}

enum AvatarStyle {
  CHIBI
  RETRATO_CIRCULAR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  /// Derivado de los relatos completados; se recalcula en cada completado,
  /// nunca se edita a mano ni se acepta desde el cliente.
  currentRank RangoAura @default(AURA_LATENTE)

  sendaPrincipal Senda?
  sendasCercanas Senda[] @default([])

  habilidadUnicaId        String?
  habilidadUnica          HabilidadUnica? @relation(fields: [habilidadUnicaId], references: [id])
  habilidadUnicaElegidaEn DateTime?

  progresos   StoryProgress[]
  logros      UserAchievement[]
  sendaTest   SendaTestResult?
  ofertaHu    OfertaHu?
  profile     UserProfile?
  sesiones    AppSession[]

  restricciones          UserRestriction[] @relation("RestriccionesDe")
  restriccionesAplicadas UserRestriction[] @relation("RestriccionesAplicadasPor")
  restriccionesLevantadas UserRestriction[] @relation("RestriccionesLevantadasPor")
}

enum RestrictionType {
  ACCION_SILENCIADA
  COMENTARIO_SILENCIADO
  BAN_COMPLETO
}

/// Moderación activa (Parte 3, sección 8): tres restricciones independientes,
/// no un único campo de estado. Nunca se borra una fila al levantarla — se
/// marca active=false con liftedBy/liftedAt para conservar el historial.
/// Expiración: se evalúa al momento de cada request (expiresAt > now); una
/// fila vencida se trata como inactiva sin necesidad de cron.
model UserRestriction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("RestriccionesDe", fields: [userId], references: [id], onDelete: Cascade)

  type   RestrictionType
  active Boolean         @default(true)
  /// Interno del equipo; nunca se muestra al usuario afectado.
  reason String
  /// null = permanente hasta levantarla a mano.
  expiresAt DateTime?

  appliedById String
  appliedBy   User      @relation("RestriccionesAplicadasPor", fields: [appliedById], references: [id])
  appliedAt   DateTime  @default(now())
  liftedById  String?
  liftedBy    User?     @relation("RestriccionesLevantadasPor", fields: [liftedById], references: [id])
  liftedAt    DateTime?

  @@index([userId, type, active])
}

/// Datos personales del lector. Política de privacidad por diseño (Parte 2,
/// sección 2.1): todo lo opcional es PRIVADO — visible solo para el propio
/// usuario; un eventual perfil público mostraría solo alias/avatar/rango/logros.
model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Alias público, obligatorio, único; pasa SIEMPRE por PlayerNameModerator.
  alias String @unique

  // Opcionales y privados; la edad se deriva de fechaNacimiento, no se guarda.
  nombre          String?
  apellidoPaterno String?
  apellidoMaterno String?
  fechaNacimiento DateTime?
  pais            String?
  ciudad          String?
  comuna          String?

  avatarId String?
  avatar   AvatarOption? @relation(fields: [avatarId], references: [id])

  themePreference ThemePreference @default(SISTEMA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Catálogo cerrado de avatares curado por Claudio. Sin subida de imágenes
/// por parte del usuario, bajo ninguna circunstancia en esta fase.
model AvatarOption {
  id            String      @id @default(cuid())
  slug          String      @unique
  characterName String
  style         AvatarStyle
  imageUrl      String
  /// Exactamente uno en true: es el avatar que recibe todo usuario nuevo.
  isDefault     Boolean     @default(false)
  /// false lo retira del selector sin romper a quienes ya lo tienen elegido.
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)

  perfiles UserProfile[]
}

/// Logros "latentes": promesas visuales sin lógica de desbloqueo. Tabla
/// separada de Achievement a propósito — nunca cuentan para la barra de
/// progreso ni requieren condiciones de servidor.
model AchievementPlaceholder {
  id        String  @id @default(cuid())
  sortOrder Int
  hintText  String?
}

/// Registro server-side de sesiones (híbrido con JWT: el token lleva el id
/// de esta fila como `sid`; toda verificación de identidad la valida aquí,
/// por lo que revocar tiene efecto inmediato en servidor).
model AppSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Derivado del user-agent (ej. "Chrome (Windows)").
  deviceLabel   String
  /// Aproximada a nivel ciudad, derivada de IP (headers de Vercel); nunca exacta.
  locationLabel String

  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId, revokedAt])
}

/// Progreso de lectura por relato. El contenido de los relatos vive en
/// src/data/stories.ts (no hay tabla de relatos en la BD), por lo que la
/// "FK" es el slug, validado en servidor contra el contenido real.
model StoryProgress {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storySlug String

  /// Posición actual (0-100). Puede bajar si el lector retrocede.
  currentProgress Int @default(0)
  /// Máximo histórico (0-100). Nunca baja.
  highestProgress Int @default(0)

  /// Se fija de forma irreversible al alcanzar highestProgress >= 95.
  completedAt             DateTime?
  /// Garantiza que la recompensa de completado se entrega una sola vez.
  completionRewardClaimed Boolean   @default(false)

  /// Relecturas completadas después de la primera lectura completa.
  rereadCount Int @default(0)
  /// Máquina de estados de relectura: se arma cuando, ya completado,
  /// el lector vuelve al inicio; se consume al alcanzar 95% otra vez.
  rereadArmed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storySlug])
  @@index([userId, completedAt])
}

/// Catálogo de logros. El contenido (título, condición) se define en código
/// (src/lib/server/achievementCatalog.ts) y se sincroniza aquí vía seed
/// idempotente; la condición de desbloqueo SIEMPRE se evalúa en servidor.
model Achievement {
  id          String         @id
  slug        String         @unique
  title       String
  description String
  category    CategoriaLogro

  usuarios UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

/// Resultado del Ritual de Afinación. Uno por usuario; la única corrección
/// permitida es la elección manual (eligioManual) y después queda fijo.
model SendaTestResult {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Respuestas crudas del ritual (ids de pregunta -> id de opción).
  respuestas Json

  sendaPrincipalResultado Senda
  sendasCercanasResultado Senda[]

  /// true si el usuario sobrescribió el resultado del cristal (una sola vez).
  eligioManual Boolean  @default(false)
  completedAt  DateTime @default(now())
}

/// Catálogo de Habilidades Únicas (77 en total entre 4 rarezas; se siembra
/// un subconjunto inicial y se completa como contenido, no como código).
model HabilidadUnica {
  id          String   @id
  nombre      String
  descripcion String
  rareza      RarezaHu
  /// Sendas con afinidad natural a esta HU (para calcularHUCompatibles).
  sendasAfines Senda[]

  usuarios User[]
}

/// Las 3 opciones presentadas en la Prueba del Aura Interna. Se persisten
/// para que /api/hu/choose solo acepte una HU realmente ofrecida.
model OfertaHu {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opciones  String[]
  createdAt DateTime @default(now())
}
